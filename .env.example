# ===========================================================================
# myflicker HTTP gateway config sample
# copy to .env and fill in real values:  cp .env.example .env
# ===========================================================================

# --- auth ---------------------------------------------------------------
# every request must send: X-API-Key: <API_KEY>
# generate one:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# --- myflicker binary ---------------------------------------------------
# absolute path is strongly recommended (does not depend on PATH)
MYFLICKER_BIN=/usr/local/bin/myflicker
# working directory for every myflicker run (absolute path); empty = inherit worker cwd
MYFLICKER_CWD=/Users/zhaojian/Desktop/myflicker-workspace

# --- timeout (seconds) --------------------------------------------------
DEFAULT_TIMEOUT=300
MAX_TIMEOUT=3600

# --- redis --------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_QUEUE=myflicker
TASK_KEY_PREFIX=myflicker:task
# task state TTL in redis (seconds)
RESULT_TTL=86400

# --- http service -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- logging ------------------------------------------------------------
# relative paths are resolved against the project directory
LOG_DIR=logs
# max chars of stdout/stderr kept in redis / jsonl (full output also saved to files)
MAX_OUTPUT_CHARS=200000

# --- request limits -----------------------------------------------------
MAX_ARGS=200
MAX_ARG_LEN=4096
POLL_HINT_MS=1000

# --- extra env vars injected into every myflicker process ---------------
# must be a single-line JSON object
EXTRA_ENV={"MYFLICKER_TOKEN":"replace-with-real-token","NO_COLOR":"1","LANG":"en_US.UTF-8"}
